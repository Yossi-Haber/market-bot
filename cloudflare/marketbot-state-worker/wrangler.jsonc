{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketbot-state-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "secrets": {
    "required": ["STATE_API_HMAC_SECRET", "STATE_ADMIN_HMAC_SECRET"]
  },
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marketbot-state",
      "database_id": "3f40e99b-8fb3-4fb8-90c7-ea1b4e019061",
      "migrations_dir": "migrations"
    }
  ]
}
